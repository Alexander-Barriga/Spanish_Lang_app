{
  "expo": {
    "name": "Spanish Lab",
    "slug": "spanishlab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "spanishlab",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1f36"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.spanishlab.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Spanish Lab needs microphone access to enable voice conversations in Spanish."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a1f36"
      },
      "package": "com.spanishlab.app",
      "permissions": ["RECORD_AUDIO"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-av",
        {
          "microphonePermission": "Allow Spanish Lab to access your microphone for voice conversations."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "YOUR_EAS_PROJECT_ID"
      },
      "revenuecat": {
        "iosApiKey": "YOUR_REVENUECAT_IOS_API_KEY",
        "androidApiKey": "YOUR_REVENUECAT_ANDROID_API_KEY",
        "entitlementId": "premium",
        "monthlyProductId": "spanishlab_monthly_1499",
        "annualProductId": "spanishlab_annual_9999"
      }
    }
  }
}
